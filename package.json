{
  "name": "@helix/root",
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "build:design": "npm run build --workspace=@helix/design",
    "build:vue": "npm run build --workspace=@helix/vue",
    "watch": "lerna run watch --parallel",
    "dev": "concurrently \"npm run watch\" \"npm run dev:example\"",
    "dev:example": "cd example && npm run dev"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@fkui/design": "6.28.0",
    "@fkui/vue": "6.28.0",
    "concurrently": "^9.0.0",
    "lerna": "^9.0.1",
    "vite": "7.2.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
